# ===== BUXGALTER AI — muhit sozlamalari (.env.example → .env nusxalang) =====

# --- Server
HOST=127.0.0.1
PORT=8000

# --- AI (bepul Gemini kaliti: https://aistudio.google.com/app/apikey)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Ixtiyoriy zaxira
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- 1C OData (standard.odata). Demo rejimda real 1C ga ulanmaydi.
ONEC_DEMO_MODE=true
ONEC_BASE_URL=http://server/buh_uz
ONEC_USER=
ONEC_PASSWORD=
ONEC_ORG_INN=

# --- Didox
DIDOX_DEMO_MODE=true
DIDOX_BASE_URL=https://api-partners.didox.uz
DIDOX_USER_KEY=
DIDOX_PARTNER_TOKEN=

# --- Telegram bot + Mini App
TELEGRAM_BOT_TOKEN=
# Mini App faqat HTTPS bilan ishlaydi (masalan: cloudflared tunnel --url http://127.0.0.1:8000)
WEBAPP_URL=
# Bot va Mini App'dan foydalanishga ruxsat berilgan Telegram ID lar (vergul bilan). Bo'sh = hech kim.
ALLOWED_TELEGRAM_IDS=

# Qo'shimcha ruxsat etilgan Host nomlari (vergul bilan). WEBAPP_URL domeni avtomatik qo'shiladi.
ALLOWED_HOSTS=

# --- Tashqi manzil (tunnel) orqali brauzerdan kirish uchun token (uzun tasodifiy satr)
APP_ACCESS_TOKEN=
