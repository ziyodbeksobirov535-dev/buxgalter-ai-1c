# ===== BUXGALTER AI — muhit sozlamalari (.env.example → .env nusxalang) =====
# Firmalar (1C / Didox ulanishlari), foydalanuvchilar va rollar — Web App'dagi ⚙️ Sozlamalar orqali boshqariladi.

# --- Server
HOST=127.0.0.1
PORT=8000

# --- AI (barcha firmalar uchun umumiy; bepul Gemini kaliti: https://aistudio.google.com/app/apikey)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Ixtiyoriy zaxira
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Firma parollarini shifrlash kaliti (ixtiyoriy). Bo'sh bo'lsa data/secret.key avtomatik yaratiladi.
# Serverga ko'chirishda shu kalitni saqlang — usiz shifrlangan 1C parollarini qayta kiritish kerak bo'ladi.
APP_SECRET_KEY=

# --- Telegram bot + Mini App
TELEGRAM_BOT_TOKEN=
# Mini App faqat HTTPS bilan ishlaydi (masalan: cloudflared tunnel --url http://127.0.0.1:8000)
WEBAPP_URL=

# Qo'shimcha ruxsat etilgan Host nomlari (vergul bilan). WEBAPP_URL domeni avtomatik qo'shiladi.
ALLOWED_HOSTS=
